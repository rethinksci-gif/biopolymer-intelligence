---
import Base from '../layouts/Base.astro';
import SourceQuote from '../components/SourceQuote.astro';
import { glossary, sourceById, fmtDate, url } from '../lib/data';
const nv = sourceById(glossary.domain_reference.source)!;
const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-');
---
<Base title="Glossary & standards" description="Terms, labels and standards used on BIOPOLYMER Intelligence.">
  <p class="crumbs"><a href={url('')}>Overview</a> / Glossary &amp; standards</p>
  <h1>Glossary &amp; standards</h1>
  <section><h2 id="terms">Terms</h2><dl class="facts">{glossary.terms.map((g) => <><dt id={slug(g.term)}>{g.term}</dt><dd>{g.text}</dd></>)}</dl></section>
  <section><h2 id="labels">Label taxonomy</h2><dl class="facts">{glossary.labels.map((g) => <><dt id={slug(g.term)}>{g.term}</dt><dd>{g.text}</dd></>)}</dl></section>
  <section>
    <h2 id="standards">Standards</h2>
    <p class="small muted narrow">Titles are shown as published by the issuing body (retrieved 20 Oct 2026 from ISO open data, the CEN catalogue, ASTM and ISCC). Scopes are not paraphrased here — follow the link.</p>
    <div class="table-wrap"><table>
      <thead><tr><th scope="col">Code</th><th scope="col">Title (as published)</th><th scope="col">Issuing body</th></tr></thead>
      <tbody>{glossary.standards.map((s) => <tr id={slug(s.code)}><td><a href={s.url}><strong>{s.code}</strong></a></td><td class="small">{s.title}{s.note && <><br /><span class="muted">{s.note}</span></>}</td><td class="small">{s.body}</td></tr>)}</tbody>
    </table></div>
  </section>
  <section>
    <h2 id="domain">Domain clarification</h2>
    <p class="narrow">Naturvårdsverket (Swedish Environmental Protection Agency), <a href={nv.url} lang="sv">{nv.title}</a> (reviewed {fmtDate(nv.date)}, retrieved {fmtDate(nv.retrieved)}). Quoted in the original Swedish with a faithful English translation:</p>
    <ul>{nv.quotes.map((q) => <li><SourceQuote k={`${nv.id}#${q.id}`} /></li>)}</ul>
  </section>
</Base>
