---
import '../styles/global.css';
import { SITE_NAME, REPO, SISTER, url } from '../lib/data';

interface Props { title?: string; description?: string }
const { title, description = 'Bio-based polymers for durable products: routes, chemistry, challenges and a monthly evidence tracker.' } = Astro.props;
const fullTitle = title ? `${title} · ${SITE_NAME}` : SITE_NAME;
const path = Astro.url.pathname;
const nav: [string, string][] = [
  ['', 'Overview'], ['routes/', 'Routes'], ['chemistry/', 'Chemistry'], ['challenges/', 'Challenges'],
  ['tracker/', 'Tracker'], ['newsletter/', 'Newsletter'], ['references/', 'Literature'], ['methods/', 'Methods'],
];
const isCurrent = (p: string) => (p === '' ? path === url('') || path === url('') + '/' : path.startsWith(url(p)));
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE_NAME}: leads`} href={url('rss.xml')} />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400..800&display=swap" rel="stylesheet" />
    <script is:inline>
      try { const t = localStorage.getItem('theme'); if (t) document.documentElement.dataset.theme = t; } catch (e) {}
    </script>
  </head>
  <body>
    <a href="#content" class="sr-skip">Skip to content</a>
    <header class="site">
      <div class="wrap bar">
        <a class="brand" href={url('')} aria-label={`${SITE_NAME} — home`}>
          <svg width="28" height="28" viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" rx="8" fill="var(--accent)"/><path d="M7 21l6-9 6 9 6-9" fill="none" stroke="var(--bg)" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/><g fill="var(--bg)"><circle cx="7" cy="21" r="2.4"/><circle cx="13" cy="12" r="2.4"/><circle cx="19" cy="21" r="2.4"/><circle cx="25" cy="12" r="2.4"/></g></svg>
          <span class="brand-text">BIOPOLYMER <span>Intelligence</span></span>
        </a>
        <nav class="main" aria-label="Main">
          {nav.map(([p, label]) => <a href={url(p)} aria-current={isCurrent(p) ? 'page' : undefined}>{label}</a>)}
        </nav>
        <div class="tools">
          <a class="icon-btn" href={url('search/')} aria-label="Search" title="Search">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
          </a>
          <button class="icon-btn" type="button" id="theme-toggle" aria-label="Toggle colour theme" title="Toggle colour theme">
            <svg class="theme-icon-light" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
            <svg class="theme-icon-dark" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          </button>
          <details class="menu">
            <summary class="icon-btn" aria-label="More pages" title="More pages">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
            </summary>
            <nav class="menu-panel" aria-label="Main (mobile)">
              {nav.map(([p, label]) => <a class="m-only" href={url(p)} aria-current={isCurrent(p) ? 'page' : undefined}>{label}</a>)}
              <a href={url('glossary/')} aria-current={isCurrent('glossary/') ? 'page' : undefined}>Glossary &amp; standards</a>
              <a href={url('data/')}>Open data</a>
            </nav>
          </details>
        </div>
      </div>
    </header>
    <main id="content" data-pagefind-body>
      <div class="wrap"><slot /></div>
    </main>
    <footer class="site">
      <div class="wrap foot-grid">
        <div>
          <a class="brand" href={url('')}><span class="brand-text">BIOPOLYMER <span>Intelligence</span></span></a>
          <p class="small muted" style="max-width:44ch">An open knowledge base and monthly evidence tracker for bio-based polymers. Facts are quoted from cited sources; machine-triaged leads are labelled as such. This site tracks development; it does not support purchasing or qualification decisions.</p>
          <p class="small muted">Sister site: <a href={SISTER.url}>{SISTER.name}</a> (bio-based wood adhesives)</p>
        </div>
        <div>
          <h4>Learn</h4>
          <ul><li><a href={url('routes/')}>Routes</a></li><li><a href={url('chemistry/')}>Chemistry</a></li><li><a href={url('challenges/')}>Challenges</a></li><li><a href={url('glossary/')}>Glossary &amp; standards</a></li></ul>
        </div>
        <div>
          <h4>Track</h4>
          <ul><li><a href={url('tracker/')}>Monthly tracker</a></li><li><a href={url('newsletter/')}>Newsletter</a></li><li><a href={url('references/')}>Literature</a></li><li><a href={url('rss.xml')}>RSS feed</a></li><li><a href={url('data/')}>Open data</a></li></ul>
        </div>
        <div>
          <h4>Contribute</h4>
          <ul><li><a href={`${REPO}/issues/new?template=lead.yml`}>Submit a lead</a></li><li><a href={`${REPO}/issues/new?template=correction.yml`}>Report a correction</a></li><li><a href={REPO}>GitHub repo</a></li><li><a href={url('methods/')}>How we verify</a></li></ul>
        </div>
      </div>
      <div class="wrap small muted" style="margin-top:20px">Content CC BY 4.0 · Code MIT · Not technical, regulatory or purchasing advice.</div>
    </footer>
    <script is:inline>
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const root = document.documentElement;
        const dark = root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
        root.dataset.theme = dark ? 'light' : 'dark';
        try { localStorage.setItem('theme', root.dataset.theme); } catch (e) {}
      });
    </script>
  </body>
</html>
