{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Routes",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "label",
      "name",
      "tagline",
      "scope",
      "what",
      "chemistry",
      "production",
      "properties",
      "eol",
      "key_players",
      "applications",
      "challenges",
      "challenge_links",
      "structures",
      "refs",
      "scan"
    ],
    "properties": {
      "id": {
        "type": "string"
      },
      "label": {
        "type": "string"
      },
      "family": {
        "type": "string"
      },
      "focus": {
        "type": "boolean"
      },
      "name": {
        "type": "string"
      },
      "tagline": {
        "type": "string"
      },
      "scope": {
        "type": "string"
      },
      "what": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "chemistry": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "production": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "properties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "eol": {
        "type": "object",
        "required": [
          "bio_based_origin",
          "biodegradability",
          "compostability",
          "recyclability"
        ],
        "additionalProperties": {
          "type": "string"
        }
      },
      "key_players": {
        "type": "array"
      },
      "applications": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "challenges": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "challenge_links": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "structures": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "refs": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "support": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "ref",
            "quote"
          ],
          "properties": {
            "ref": {
              "type": "string"
            },
            "quote": {
              "type": "string",
              "minLength": 10
            }
          }
        }
      },
      "scan": {
        "type": "object",
        "properties": {
          "crossref": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "news": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "news_i18n": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "additionalProperties": false
  }
}
