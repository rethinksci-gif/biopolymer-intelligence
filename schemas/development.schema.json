{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Checked development (12-point evidence record)",
  "type": "object",
  "required": [
    "id",
    "month",
    "title",
    "route",
    "label",
    "novelty_type",
    "event",
    "published_date",
    "sources",
    "review",
    "attributes"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "month": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}$"
    },
    "title": {
      "type": "string"
    },
    "route": {
      "type": "string",
      "enum": [
        "pla",
        "pha",
        "pef",
        "bio-polyesters",
        "polyamides",
        "polycarbonates",
        "polyurethanes",
        "thermosets",
        "natural-polymers",
        "scope-review"
      ]
    },
    "lead_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "dedupe_key": {
      "type": "object",
      "properties": {
        "technology": {
          "type": "string"
        },
        "organization": {
          "type": "string"
        },
        "facility": {
          "type": "string"
        },
        "event": {
          "type": "string"
        }
      }
    },
    "repeat_reason": {
      "enum": [
        "new-milestone",
        "correction",
        "reversal",
        null
      ]
    },
    "polymer_family": {
      "type": "string"
    },
    "feedstock": {
      "type": "string"
    },
    "monomers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "synthesis_route": {
      "type": "string"
    },
    "novelty_type": {
      "type": "string",
      "enum": [
        "new-chemistry",
        "new-route",
        "new-formulation-or-application",
        "scale-or-supply"
      ]
    },
    "novelty_note": {
      "type": "string"
    },
    "event": {
      "type": "string"
    },
    "published_date": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "event_date": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "url"
        ],
        "properties": {
          "url": {
            "type": "string"
          },
          "doi": {
            "type": [
              "string",
              "null"
            ]
          },
          "locator": {
            "type": "string"
          },
          "quote": {
            "type": "string"
          },
          "published": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "kind": {
            "type": "string"
          }
        }
      }
    },
    "actors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "role"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "role": {
            "enum": [
              "research",
              "supplier",
              "producer",
              "partner",
              "brand_owner"
            ]
          }
        }
      }
    },
    "research_location": {
      "type": "string"
    },
    "production_site": {
      "type": "string"
    },
    "target_region": {
      "type": "string"
    },
    "demonstrated_stage": {
      "enum": [
        "lab",
        "pilot",
        "demo",
        "industrial",
        "Not disclosed"
      ]
    },
    "plans": {
      "type": "string"
    },
    "trl": {
      "type": "object",
      "required": [
        "value"
      ],
      "properties": {
        "value": {
          "type": [
            "string",
            "number",
            "null"
          ]
        },
        "quote": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "locator": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "is_estimate": {
          "type": "boolean"
        }
      }
    },
    "capacity": {
      "type": "object",
      "required": [
        "value"
      ],
      "properties": {
        "value": {
          "type": [
            "string",
            "number",
            "null"
          ]
        },
        "quote": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "locator": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        },
        "facility": {
          "type": "string"
        },
        "grade": {
          "type": "string"
        },
        "status": {
          "enum": [
            "announced",
            "under_construction",
            "commissioned",
            "operating",
            "actual_output",
            null
          ]
        }
      }
    },
    "performance": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "value"
        ],
        "properties": {
          "value": {
            "type": [
              "string",
              "number",
              "null"
            ]
          },
          "quote": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "locator": {
            "type": "string"
          },
          "property": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "method": {
            "type": "string"
          },
          "conditions": {
            "type": "string"
          },
          "comparator": {
            "type": "string"
          },
          "measured_or_claimed": {
            "enum": [
              "measured",
              "claimed"
            ]
          }
        }
      }
    },
    "cost": {
      "type": "object",
      "required": [
        "value"
      ],
      "properties": {
        "value": {
          "type": [
            "string",
            "number",
            "null"
          ]
        },
        "quote": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "locator": {
          "type": "string"
        },
        "currency": {
          "type": "string"
        },
        "date": {
          "type": "string"
        },
        "region": {
          "type": "string"
        },
        "volume": {
          "type": "string"
        },
        "grade": {
          "type": "string"
        },
        "basis": {
          "enum": [
            "selling_price",
            "production_cost",
            "target",
            null
          ]
        }
      }
    },
    "climate": {
      "type": "object",
      "required": [
        "value"
      ],
      "properties": {
        "value": {
          "type": [
            "string",
            "number",
            "null"
          ]
        },
        "quote": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "locator": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        },
        "functional_unit": {
          "type": "string"
        },
        "boundary": {
          "type": "string"
        },
        "geography": {
          "type": "string"
        },
        "data_year": {
          "type": "string"
        },
        "energy_mix": {
          "type": "string"
        },
        "comparator": {
          "type": "string"
        },
        "comparator_boundary": {
          "type": "string"
        },
        "allocation": {
          "type": "string"
        },
        "biogenic_carbon": {
          "type": "string"
        },
        "review": {
          "enum": [
            "supplier",
            "independent",
            null
          ]
        },
        "reduction": {
          "type": "string"
        }
      }
    },
    "residual_fossil": {
      "type": "string"
    },
    "feedstock_availability": {
      "type": "string"
    },
    "eol_constraints": {
      "type": "string"
    },
    "main_barrier": {
      "type": "string"
    },
    "missing_evidence": {
      "type": "string"
    },
    "next_question": {
      "type": "string"
    },
    "attributes": {
      "type": "object",
      "required": [
        "bio_based_origin",
        "biobased_carbon_measured",
        "mass_balance",
        "biodegradable_env",
        "compostable",
        "recyclable"
      ],
      "properties": {
        "bio_based_origin": {
          "type": "object",
          "required": [
            "value"
          ],
          "properties": {
            "value": {
              "type": "string"
            },
            "quote": {
              "type": "string"
            },
            "source": {
              "type": "string"
            }
          }
        },
        "biobased_carbon_measured": {
          "type": "object",
          "required": [
            "value"
          ],
          "properties": {
            "value": {
              "type": "string"
            },
            "quote": {
              "type": "string"
            },
            "source": {
              "type": "string"
            }
          }
        },
        "mass_balance": {
          "type": "object",
          "required": [
            "value"
          ],
          "properties": {
            "value": {
              "type": "string"
            },
            "quote": {
              "type": "string"
            },
            "source": {
              "type": "string"
            }
          }
        },
        "biodegradable_env": {
          "type": "object",
          "required": [
            "value"
          ],
          "properties": {
            "value": {
              "type": "string"
            },
            "quote": {
              "type": "string"
            },
            "source": {
              "type": "string"
            }
          }
        },
        "compostable": {
          "type": "object",
          "required": [
            "value"
          ],
          "properties": {
            "value": {
              "type": "string"
            },
            "quote": {
              "type": "string"
            },
            "source": {
              "type": "string"
            }
          }
        },
        "recyclable": {
          "type": "object",
          "required": [
            "value"
          ],
          "properties": {
            "value": {
              "type": "string"
            },
            "quote": {
              "type": "string"
            },
            "source": {
              "type": "string"
            }
          }
        }
      }
    },
    "label": {
      "enum": [
        "peer-reviewed",
        "supplier announcement",
        "preprint/patent lead",
        "hold"
      ]
    },
    "tracking": {
      "enum": [
        "watch",
        "data-gap",
        "milestone",
        null
      ]
    },
    "selection_score": {
      "type": "object",
      "properties": {
        "relevance": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "novelty": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "evidence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "consequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "learning": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        }
      }
    },
    "review": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "draft",
            "evidence-checked",
            "signed"
          ]
        },
        "reviewer": {
          "type": [
            "string",
            "null"
          ]
        },
        "date": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    }
  }
}
